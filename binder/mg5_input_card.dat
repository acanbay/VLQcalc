import model VLQ_v4_4FNS_UFO
define VLB = bp bp~
define WW = w+ w-
define tt = t t~
define bb = b b~
generate p p > VLB j, (VLB > WW tt, tt > WW bb)
add process p p > VLB j bb, (VLB > WW tt, tt > WW bb)
output mg5_input_card
launch mg5_input_card
shower=Pythia8
detector=Delphes
analysis=OFF
madspin=OFF
reweight=OFF
done
set Nevents 1000
set MTP scan1:[1000, 1250, 1500, 1750, 2000]
set KTLh1 scan1:[0.509283, 0.50639, 0.504831, 0.503897, 0.503292]
set KTRh1 0
set KTLh2 scan1:[0.720235, 0.716143, 0.713939, 0.712617, 0.711762]
set KTRh2 0
set KTLh3 scan1:[1.34873, 1.3403, 1.3359, 1.33332, 1.33166]
set KTRh3 0
set KTLw1 scan1:[0.0617221, 0.0493759, 0.0411461, 0.0352679, 0.0308593]
set KTRw1 0
set KTLw2 scan1:[0.0872882, 0.0698281, 0.0581893, 0.0498763, 0.0436416]
set KTRw2 0
set KTLw3 scan1:[0.163307, 0.130639, 0.108864, 0.093311, 0.0816467]
set KTRw3 0
set KTLz1 scan1:[0.0872919, 0.0698293, 0.0581898, 0.0498765, 0.0436417]
set KTRz1 0
set KTLz2 scan1:[0.123449, 0.0987535, 0.0822928, 0.070536, 0.0617187]
set KTRz2 0
set KTLz3 scan1:[0.241597, 0.190126, 0.157043, 0.133896, 0.116758]
set KTRz3 0
done
