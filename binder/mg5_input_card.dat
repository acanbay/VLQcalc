import model VLQ_v4_4FNS_UFO
define VLB = bp bp~
define WW = w+ w-
define tt = t t~
define bb = b b~
generate p p > VLB j, (VLB > WW tt, tt > WW bb)
add process p p > VLB j bb, (VLB > WW tt, tt > WW bb)
output mg5_input_card
launch mg5_input_card
shower=Pythia8
detector=Delphes
analysis=OFF
madspin=OFF
reweight=OFF
done
set MBP scan1:[1000, 1500, 2000]
set KBLh1 0
set KBRh1 0
set KBLh2 0
set KBRh2 0
set KBLh3 scan1:[1.13339, 1.12529, 1.12275]
set KBRh3 scan1:[1.13339, 1.12529, 1.12275]
set KBLw1 0
set KBRw1 0
set KBLw2 0
set KBRw2 0
set KBLw3 scan1:[0.289757, 0.187888, 0.13961]
set KBRw3 scan1:[0.289757, 0.187888, 0.13961]
set KBLz1 0
set KBRz1 0
set KBLz2 0
set KBRz2 0
set KBLz3 scan1:[0.276083, 0.184021, 0.13801]
set KBRz3 scan1:[0.276083, 0.184021, 0.13801]
set WBP auto
set nevents 10000
done
